# Runtime
APP_ENV=development
APP_DEBUG=false
JWT_SECRET=replace-with-at-least-32-random-characters
PII_HASH_KEY=replace-with-a-different-32-character-random-key

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=wemini
DB_PASSWORD=replace-me
DB_NAME=wemini_app

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# WeChat login
WECHAT_APPID=
WECHAT_SECRET=

# WeChat Pay (V3 only; production startup requires all fields)
WECHAT_PAY_ENABLED=false
WECHAT_PAY_API_VERSION=v3
WECHAT_PAY_MCHID=
WECHAT_PAY_APPID=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_REFUND_NOTIFY_URL=
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_CERTIFICATE=
WECHAT_PAY_PLATFORM_CERT_SERIAL_NO=
WECHAT_PAY_NOTIFICATION_TOLERANCE_SECONDS=300
WECHAT_PAY_RECONCILE_POLL_SECONDS=30
WECHAT_PAY_RECONCILE_BATCH_SIZE=100
WECHAT_PAY_REFUND_RECONCILE_POLL_SECONDS=30
WECHAT_PAY_REFUND_RECONCILE_BATCH_SIZE=100
WECHAT_PAY_REFUND_RECONCILE_AFTER_SECONDS=60
WECHAT_PAY_SYNC_RATE_PER_MINUTE=10

# Human-resources private storage. Production requires aliyun_oss.
RENSHE_STORAGE_TYPE=local
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_PREFIX=renshe
ALIYUN_OSS_SIGNED_URL_TTL_SECONDS=300
RENSHE_TEMPLATE_DIR=../docs/renshe
RENSHE_WORKER_POLL_SECONDS=5
# Production must remain 30; only isolated non-production cleanup UAT may shorten it.
RENSHE_CLEANUP_RETENTION_DAYS=30
HEALTH_CHECK_TIMEOUT_SECONDS=3

# Quiz imports use private OSS in production. Limits below are frozen by code.
QUIZ_TASKS_ENABLED=true
QUIZ_IMPORT_STORAGE_TYPE=local
QUIZ_OSS_ENDPOINT=
QUIZ_OSS_BUCKET=
QUIZ_OSS_ACCESS_KEY_ID=
QUIZ_OSS_ACCESS_KEY_SECRET=
QUIZ_OSS_PREFIX=quiz-imports
QUIZ_OSS_SIGNED_URL_TTL_SECONDS=300
QUIZ_WORKER_POLL_SECONDS=5
QUIZ_WORKER_HEARTBEAT_SECONDS=15
QUIZ_WORKER_STALE_SECONDS=120
QUIZ_WORKER_MAX_RETRIES=5

# Set only for the destructive migration command after verifying the backup.
# QUIZ_DESTRUCTIVE_MIGRATION_BACKUP_REF=oss://backups/example.dump

# Explicit one-time bootstrap; leave disabled after initialization.
ENABLE_INITIAL_SUPER_ADMIN=0
INITIAL_SUPER_ADMIN_USERNAME=
INITIAL_SUPER_ADMIN_PASSWORD=
